<?xml version="1.0" encoding="utf-8"?><Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build" ToolsVersion="16.0">
  <Target Name="EmbedCodeExampleResources" BeforeTargets="PrepareForBuild">
