@namespace DevExpress.AI.Demos
@using Microsoft.AspNetCore.Components.Web
@using DevExpress.AIIntegration.Blazor.Chat
@using DevExpress.AI.Demos.Models
@using System.Text.Json
@using Markdig

<div>
    @{
        var weatherData = GetWeatherFromFunctionCalls(Message.FunctionCalls);
        if (weatherData != null)
        {
            <div style="padding: 0.5rem 0 0.5rem 0;">
                <WeatherWidgetComponent WeatherData="@weatherData" />
            </div>
        }
        if (!string.IsNullOrWhiteSpace(Message.Content))
        {
            <div>@ToHtml(Message.Content)</div>
        }
    }
</div>

@code {
    [Parameter] public BlazorChatMessage Message { get; set; } = default!;

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
    static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder().DisableHtml().Build();

    MarkupString ToHtml(string markdown)
    {
        string html = Markdown.ToHtml(markdown, MarkdownPipeline);
        return new MarkupString(html);
    }

    WeatherWidgetData GetWeatherFromFunctionCalls(List<AIChatFunctionCall> functionCalls)
    {
        if (functionCalls == null || functionCalls.Count == 0)
            return null;
        var weatherCall = functionCalls.Find(
            fc => fc.Request?.Name == "GetWeather" && fc.Result?.Result != null);
        if (weatherCall == null)
            return null;
        try
        {
            var json = weatherCall.Result.Result.ToString();
            if (string.IsNullOrWhiteSpace(json))
                return null;
            var data = JsonSerializer.Deserialize<WeatherWidgetData>(json, JsonOptions);
            return data?.CityName != null ? data : null;
        }
        catch
        {
            return null;
        }
    }
}
