@namespace DevExpress.AI.Demos

<div class="empty-state-container">
    <div class="empty-state-icon">@((MarkupString)Icon)</div>
    <div class="empty-state-title">@((MarkupString)Title)</div>
    <div class="empty-state-description">@((MarkupString)Description)</div>
</div>

<style>
    .empty-state-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 0.75rem;
        color: var(--dxds-color-content-neutral-default-static-light-disabled);
    }

    .empty-state-icon {
        font-size: 2rem;
        line-height: 1;
    }

    .empty-state-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--dxds-color-content-neutral-deep-active);
    }

    .empty-state-description {
        font-size: 0.75rem;
        max-width: 420px;
        line-height: 1.5;
        color: var(--dxds-color-content-neutral-deep-rest);
    }
</style>

@code {
    [Parameter] public string Icon { get; set; } = default!;
    [Parameter] public string Title { get; set; } = default!;
    [Parameter] public string Description { get; set; } = default!;
}
