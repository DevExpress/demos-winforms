@namespace DevExpress.AI.Demos
@using Microsoft.AspNetCore.Components.Web
@using DevExpress.AIIntegration.Blazor.Chat
@using System.IO

<div class="@GetMessageClasses(Context)">
    @if(Context.Typing) {
        <span>Loading...</span>
    } else {
        <div class="demo-chat-content">
			@if (Context.Files != null && Context.Files.Count > 0) {
                <div class="demo-chat-file-list">
                    @foreach (var file in Context.Files) {
                        var isImage = ImageExtensions.Contains(Path.GetExtension(file.Name));
                        @if (isImage) {
                            <div class="demo-chat-file-base custom-preview">
                                <img src="@GetImageSrc(file)" class="demo-chat-file-preview" alt="@file.Name" />
                                <div class="demo-chat-file-preview-title demo-chat-file-name">
                                    <span>@file.Name</span>
                                </div>
                            </div>
                        } else {
                            <div class="demo-chat-file-base default-preview">
                                <div class="demo-chat-file-icon-container">
                                    <img src="@FileIconBase64" class="demo-chat-file-icon" />
                                </div>
                                <span class="demo-chat-file-name">@file.Name</span>
                            </div>
                        }
                    }
                </div>
            }
            <div class="dxbl-chatui-message-text">
                @Context.Text
            </div>
        </div>
    }
</div>

<style>
	.demo-chat-content {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    .demo-chat-file-list {
        display: flex;
        gap: 8px;
    }
    .demo-chat-file-base {
        display: flex;
        border-radius: 8px;
        background: var(--dxds-color-surface-neutral-default-rest);
        width: 200px;
    }
    .custom-preview {
        align-items: flex-start;
        flex-direction: column;
    }
    .default-preview {
        align-items: center;
        flex-direction: row;
        padding: 8px;
        gap: 8px;
    }
	.demo-chat-file-preview {
        aspect-ratio: 3/2;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        width: 100%;
        height: auto;
    }
        .demo-chat-file-preview-title {
            padding: 4px 8px 8px 8px;
        }
        .demo-chat-file-icon-container {
            padding: 6px;
            border-radius: 4px;
            background: var(--dxds-color-surface-neutral-default-rest);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
        }
            .demo-chat-file-icon {
                width: 1.25rem;
                height: 1.25rem;
            }
        .demo-chat-file-name {
            text-overflow: ellipsis;
            white-space: nowrap;
            overflow: hidden;
            width: 100%;
        }
</style>
