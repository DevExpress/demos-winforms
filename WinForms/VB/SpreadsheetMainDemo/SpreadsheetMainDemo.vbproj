      <LastGenOutput>nwindDataSet.Designer.vb</LastGenOutput>
      <SubType>Designer</SubType>
    </Content>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Modules\About.resx">
      <DependentUpon>About.vb</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="SpreadsheetPreview.resx">
      <DependentUpon>SpreadsheetPreview.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="SpreadsheetRibbonTutorialControlBase.resx">
      <DependentUpon>SpreadsheetRibbonTutorialControlBase.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="XtraSpreadsheet.png" />
    <EmbeddedResource Include="XtraSpreadsheet_light.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="AppIcon.ico" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.VisualBasic.targets" />
