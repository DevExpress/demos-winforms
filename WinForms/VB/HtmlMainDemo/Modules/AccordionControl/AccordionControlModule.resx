  <data name="accordionControl1.HtmlTemplates.ItemContent.Styles" xml:space="preserve">
    <value>.item {
	padding-right: 1px;
	padding-left: 1px;
	padding-bottom: 3px;
}

.item_layout {
	border-radius: 5px;
	border-left: 6px solid @HighlightAlternate;
	background-color: @Window;
	box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.1);
	border-radius: 0px 0px 4px 4px;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	height: 100%;
}</value>
  </data>
