  <data name="accordionControl1.HtmlTemplates.Item.Styles" xml:space="preserve">
    <value>.item {
	padding-right: 1px;
	padding-left: 1px;
	padding-bottom: 3px;
}
.expanded_item {
	padding-right: 1px;
	padding-left: 1px;
}

.content {
	border-radius: 4px;
	background-color: @Window;
	border-left: 6px solid @Window;
	box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.1);
}
.active_content {
	border-left: 6px solid @HighlightAlternate;
	border-radius: 4px;
	background-color: @Window;
	box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.1);
}
.expanded_content {
	border-radius: 4px 4px 0px 0px;
	border-left: 6px solid @HighlightAlternate;
	background-color: @Window;
	box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.1);
	padding-bottom: 2px;
}
.expanded_layout {
	/*width: 100%;*/
	border-bottom: 1px solid @WindowText/0.1;
}

.item_layout {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-right: 6px;
	padding: 18px 44px 18px 26px;
}

.leftpart {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.description {
	font-family: 'Segoe UI';
	font-style: normal;
	font-weight: 400;
	font-size: 12px;
	line-height: 18px;
	color: @DisabledText;
}

.caption {
	font-family: 'Segoe UI';
	font-style: normal;
	font-weight: bolder;
	font-size: 14px;
	line-height: 20px;
	color: @WindowText;
}
.text_container {
	padding-left: 26px;
}
.image_container {
	width: 32px;
	height: 32px;
}
.image {
	fill: @WindowText;
}</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.Item.Template" xml:space="preserve">
    <value>&lt;div dx-class="{Expanded:expanded_item,item}"&gt;
	&lt;div dx-class="{Expanded:expanded_content,content; IsActive:active_content}"&gt;
		&lt;div dx-class="{Expanded:expanded_layout}"&gt;
			&lt;div class="item_layout" id="content"&gt;
				&lt;div class="leftpart"&gt;
					&lt;div class="image_container"&gt;
						&lt;img class="image" src="${Image}" width="32" height="32"/&gt;
					&lt;/div&gt;
