  <data name="htmlTemplate1.Styles" xml:space="preserve">
    <value>body {
	background-color: @Window;
	padding: 3px 10px 3px 3px;
	
}
.control {
	padding-right: 16px;
	display: flex;
	flex-direction: row-reverse;
	height: 100%;
	background-color: @Window; 
	box-shadow: 0px 1px 2px @WindowText/0.1;
	border-radius: 4px;
}
.text {
	align-self: center;
	font-family: 'Segoe UI';
	font-style: normal;
	font-size: 14px;
	line-height: 20px;
	color: @WindowText;
	flex-grow: 1;
}
.disabled_text {
	color: @DisabledText;
}
.glyph{
	align-self: center;
	fill: @WindowText;
}
.button {
	width: 44px;
	height: 30px;
	display: flex;
	justify-content: center;
	align-self: center;
	margin: 2px;
	border-radius: 4px;
}

.control:hover {
	background-color: @ControlText/0.1;
}
.control:active {
	opacity: 0.5;
	background-color: @ControlText/0.1;
}</value>
  </data>
  <data name="htmlTemplate1.Template" xml:space="preserve">
    <value>&lt;div class="control"&gt;
	&lt;div class="button" id="button"&gt;
		&lt;img class="glyph" src="dropdown" width="16" height="16"/&gt;
	&lt;/div&gt;
	&lt;div class="text" dx-class="{HasValue:,disabled_text}"&gt;${Value}&lt;/div&gt;
&lt;/div&gt;</value>
