  <data name="accordionControl1.HtmlTemplates.FooterElement.Styles" xml:space="preserve">
    <value>body {
	padding: 2px;
}
.item {
	border-radius: 4px;
	padding: 10px;
}
:root:hover .item {
	background-color: @ControlText/0.05;
}
:root:active .item {
	background-color: @ControlText/0.1;
}
:root:select .item {
	background-color: @ControlText/0.1;
}
.item-image {
	fill: @ControlText/0.5;
	width: 24px;
	height: 24px;
}
:root:active .item-image {
	fill: @ControlText/0.25;
}
.image-container {
	width: 24px;
	height: 24px;
}</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.FooterPanel.Styles" xml:space="preserve">
    <value>.footer-panel {
	height: 100%;
	display: flex;
	flex-direction: column;
	padding: 14px;
	background-color: @Control;
}

.content {
	flex-grow: 1;
	display: flex;
	background-color: @HighlightAlternate/0.01;
}
</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.HamburgerHeaderPanel.Styles" xml:space="preserve">
    <value>.header-panel {
	display: flex;
	align-items: center;
	padding: 16px;
}
.filter-control-area {
	flex-grow: 1;
	height: 36px;
	color: @WindowText;
}
.hidden {
	display: none;
}
.content {
	width: 36px;
	height: 36px;
}
.search-item {
	border-radius: 4px;
	padding: 4px;
	width: 24px;
	height: 24px;
}
.search-item:hover {
	background-color: @ControlText/0.05;
}
.search-item:active {
	background-color: @ControlText/0.1;
}
.item-image {
	fill: @ControlText/0.5;
	width: 24px;
	height: 24px;
	object-fit: contain;
}
.item-image:active {
	fill: @ControlText/0.25;
}</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.HamburgerHeaderPanel.Template" xml:space="preserve">
    <value>&lt;div class="header-panel"&gt;
	&lt;div&gt;
		&lt;div class="search-item" id="searchbutton" dx-class="{IsControlExpanded:,hidden}"&gt;
			&lt;img class="item-image" src="Search" width="24" height="24" /&gt;
		&lt;/div&gt;
	&lt;/div&gt;
	&lt;div class="filter-control-area" id="filtercontrol" dx-class="{IsControlExpanded:,hidden}"&gt;&lt;/div&gt;
	&lt;div id="content" class="content"&gt;&lt;/div&gt;
&lt;/div&gt;</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.HamburgerMenuButton.Styles" xml:space="preserve">
    <value>.container {
	display: flex;
}
.hidden {
	display: none;
}
.menu-button {
	border-radius: 4px;
	padding: 8px;
	display: flex;
}
.menu-button:hover {
	background-color: @ControlText/0.05;
}
.menu-button:active {
	background-color: @ControlText/0.1;
}
.item-image {
	fill: @ControlText/0.5;
	width: 20px;
	height: 20px;
}
:root:active .item-image {
	fill: @ControlText/0.25;
}
</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.HamburgerMenuButton.Template" xml:space="preserve">
    <value>&lt;div class="container"&gt;
	&lt;div class="menu-button"&gt;
		&lt;div dx-class="{IsControlExpanded:,hidden}"&gt;
			&lt;img class="item-image" src="Collapse"&gt;
		&lt;/div&gt;
		&lt;div dx-class="{IsControlExpanded:hidden}"&gt;
			&lt;img class="item-image" src="Expand"&gt;
		&lt;/div&gt;
	&lt;/div&gt;
&lt;/div&gt;
</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.Item.Styles" xml:space="preserve">
    <value>.item {
	border-radius: 8px;
	background-color: @Window;
	box-shadow: 0px 1px 0px rgba(60, 60, 60, 0.1);
	margin: 0px 16px 8px 16px;
}

.item_layout {
	border-radius: 8px;
	padding: 26px 24px 24px 24px;
	font-size: 12px;
	color: @WindowText;
	display: flex;
	flex-direction: column;
	align-items: center;
}

body:hover .item_layout {
	background-color: @Highlight/0.05;
}

.item_image { 
	margin-bottom: 10px;
	width: 48px;
	height: 48px;
	align-self: center;
}
.image {
	fill: @WindowText;
}

.item_text {
	font-family: 'Segoe UI';
	font-style: normal;
	font-weight: bolder;
	font-size: 18px;
	line-height: 24px;
	color: @WindowText;
	padding-bottom: 13px;
}

.item-state {
	font-weight: 400;
	font-size: 12px;
	font-family: 'Segoe UI';
	color: @WindowText;
	cursor: pointer;
}

.item-state:hover {
	
}

body:hover .item {
	background-color: @Highlight/0.05;
}
.category_content{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}
.categories {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}
.hidden {
	display: none;
}
.dot {
	background-color: @DisabledText/0.5;
	border-radius: 3px;
	margin: 2px 4px 0px 4px;
	width: 5px;
	height: 5px;
}

.category {
	color: @WindowText;
	cursor: pointer;
	font-family: 'Segoe UI';
	font-style: normal;
	font-size: 12px;
	line-height: 16px;
	color: @WindowText;
}

.category:hover {
	text-decoration: underline;
}</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.Item.Template" xml:space="preserve">
    <value>&lt;template id="category-template"&gt;
	&lt;div class="category_content"&gt;
		&lt;div class="category"&gt;${Name}&lt;/div&gt;
		&lt;div class="dot" dx-class="{dx-last:hidden}"&gt;&lt;/div&gt;
	&lt;/div&gt;
&lt;/template&gt;

&lt;div class="item"&gt;
	&lt;div class="item_layout"&gt;
		&lt;div class="item_image"&gt;
			&lt;img class="image" src="${Image}" /&gt;
		&lt;/div&gt;
		&lt;div class="item_text"&gt;${Text}&lt;/div&gt;
		&lt;dx-collection class="categories" Items="${Categories1}" ItemTemplate="category-template"&gt;&lt;/dx-collection&gt;
		&lt;dx-collection class="categories" Items="${Categories2}" ItemTemplate="category-template"&gt;&lt;/dx-collection&gt;
	&lt;/div&gt;
&lt;/div&gt;</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.MinimizedElement.Styles" xml:space="preserve">
    <value>.item_container {
	background-color: @Window;
	padding: 1px 8px 1px 8px;
	width: 40px;
	display: flex;
}
.item {
	padding: 10px;
	width: 20px;
	height: 20px;
	border-radius: 4px;
}
.top_item_container {
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	padding-top: 8px;
}
.bottom_item_container {
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
	padding-bottom: 8px;
}
body {
	padding: 0px 8px 0px 8px;
}
body:hover .item_image {
	color: @HighlightText;
}
body:hover .item {
	background-color: @HighlightAlternate/0.1;
}

body:active .item{
	background-color: @HighlightAlternate/0.1;
}

:root:select .item {
	background-color: @HighlightAlternate/0.1;
}
.item_image {
	width: 20px;
	height: 20px;
	fill: @WindowText;
	object-fit: contain;
}
.image_container {
	width: 20px;
	height: 20px;
}</value>
  </data>
  <data name="accordionControl1.HtmlTemplates.MinimizedElement.Template" xml:space="preserve">
    <value>&lt;div class="item_container" dx-class="{IsFirst:top_item_container; IsLast:bottom_item_container}"&gt;
	&lt;div class="item"&gt;
		&lt;div class="image_container"&gt;
			&lt;img class="item_image" src="${Image}" width="20" height="20" /&gt;
		&lt;/div&gt;
	&lt;/div&gt;
&lt;/div&gt;</value>
  </data>
</root>