  <data name="htmlContentControl1.HtmlTemplate.Styles" xml:space="preserve">
    <value>body {
	padding: 0px 0px 24px 16px;
	background-color: @Window;
	display: flex;
	flex-direction: column;
}
.table {
	display: flex;
	flex-direction: column;
}
.row {
	display: flex;
	flex-direction: row;
}
.column {
	flex-basis: 20px;
	flex-grow: 1;
}
.total{
	padding-top: 8px;
	padding-bottom: 8px;
}
.center_column {
	padding-left: 32px;
	padding-right: 32px;
}
.headertext{
	height: 18px;
	font-family: 'Segoe UI';
	font-style: normal;
	font-weight: bolder;
	font-size: 10px;
	color: @WindowText;
}
.summarytext{
	font-family: 'Segoe UI';
	font-style: normal;
	font-weight: bolder;
	font-size: 18px;
	line-height: 24px;
	color: @WindowText;
}
.maintext{
	font-family: 'Segoe UI';
	font-style: normal;
	font-weight: 400;
	font-size: 14px;
	line-height: 20px;
	color: @WindowText;
	display: flex;
	flex-direction: row;
}
.button {
	padding: 12px 32px;
	justify-content: center;
	align-items: center;
	margin-bottom: 1px;
	background-color: @HighlightAlternate;
	margin-right: 8px;
	box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.1);
	border-radius: 4px;
	display: flex;
	align-self: flex-end;
	color: White;
}
.button:hover {
	box-shadow: 0px 8px 16px @HighlightAlternate/0.5;
}
.button:active {
	box-shadow: 0px 0px 0px;
	color: rgba(255, 255, 255, 0.35);
}
.button_text {
	font-family: 'Segoe UI';
	font-style: normal;
	font-weight: bolder;
	font-size: 14px;
	line-height: 20px;
	text-align: center;
}
.bottom_panel {
	display: flex;
	padding-top: 42px;
}</value>
  </data>
  <data name="htmlContentControl1.HtmlTemplate.Template" xml:space="preserve">
    <value>&lt;div class="table"&gt;
	&lt;div class="row"&gt;
		&lt;div class="column headertext"&gt;PERSONAL INFORMATION&lt;/div&gt;
		&lt;div class="column center_column headertext"&gt;SHIPPING&lt;/div&gt;
		&lt;div class="column headertext"&gt;BILLING&lt;/div&gt;
	&lt;/div&gt;
	&lt;div class="row"&gt;
		&lt;div class="column maintext"&gt;${FirstName} {LastName}&lt;/div&gt;
		&lt;div class="column center_column maintext"&gt;${ShippingAddress1}&lt;/div&gt;
		&lt;div class="column maintext"&gt;${BillingAddress1}&lt;/div&gt;
	&lt;/div&gt;
	&lt;div class="row"&gt;
		&lt;div class="column maintext"&gt;${Email}&lt;/div&gt;
		&lt;div class="column center_column maintext"&gt;${ShippingAddress2}&lt;/div&gt;
		&lt;div class="column maintext"&gt;${BillingAddress2}&lt;/div&gt;
	&lt;/div&gt;
	&lt;div class="row"&gt;
		&lt;div class="column maintext"&gt;&lt;/div&gt;
		&lt;div class="column center_column maintext"&gt;${DeliveryValue}&lt;/div&gt;
		&lt;div class="column maintext"&gt;$Card ending with {CardLastNumbers}&lt;/div&gt;
	&lt;/div&gt;
	&lt;div class="total headertext"&gt;TOTAL&lt;/div&gt;
	&lt;div class="column summarytext"&gt;$${TotalPrice}&lt;/div&gt;
&lt;/div&gt;
&lt;div class="bottom_panel"&gt;
	&lt;div class="button" id="nextbutton"&gt;
		&lt;div class="button_text"&gt;Place Order&lt;/div&gt;
	&lt;/div&gt;
&lt;/div&gt;</value>
