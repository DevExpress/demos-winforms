  <data name="schedulerControl.OptionsFlyout.HtmlTemplate.Styles" xml:space="preserve">
    <value>.root {
	padding: 16px; 
	justify-content: flex-start; 
	align-items: flex-start; 
	display: inline-flex;
}
.main-area {
	width: 280px; 
	padding: 4px; 
	border-radius: 4px; 
	display: flex; 
	overflow: hidden; 
	margin-right: 24px;
}
.bar {
	width: 8px;
	height: 184px;
	border-radius: 100px;
}
.main-text-area {
	width: 260px; 
	padding-left: 20px; 
	padding-right: 20px; 
	padding-top: 12px; 
	padding-bottom: 12px; 
	flex-direction: column; 
	justify-content: flex-start; 
	align-items: flex-start;	
}
.subject {
	align-self: stretch; 
	font-size: 18px;
	font-family: Segoe UI;
	font-weight: bold;
	word-wrap: break-word;
	margin-bottom: 8px;
}
.description {
	align-self: stretch;
	font-size: 8.25pt;
	font-family: Segoe UI;
	font-weight: normal;
	word-wrap: break-word;
}
.field-group {
	padding-top: 4px;
	padding-bottom: 4px;
	padding-right: 20px;
	flex-direction: column;
	display: inline-flex;
}
.field-area {
    align-self: stretch; 
    height: 38px; 
    flex-direction: column; 
    justify-content: flex-start; 
    align-items: flex-start; 
    display: flex;	
	padding-top: 4px; 
	padding-bottom: 4px;
}
.field-name {
	align-self: stretch;
	font-size: 8.25pt;
	font-family: Segoe UI; 
	font-weight: bold; 
	word-wrap: break-word;
	padding-top: 1px;
	padding-bottom: 1px;
}
.field-value {
    align-self: stretch;     
    font-size: 8.25pt; 
    font-family: Segoe UI; 
    font-weight: normal; 
    word-wrap: break-word;	
	padding-top: 1px;
	padding-bottom: 1px;
}
</value>
  </data>
  <data name="schedulerControl.OptionsFlyout.HtmlTemplate.Template" xml:space="preserve">
    <value>&lt;div class="root"&gt;
    &lt;div class="colorized-area main-area"&gt;
        &lt;div class='with-status bar'&gt;&lt;/div&gt;
        &lt;div class="main-text-area"&gt;
            &lt;div class="subject"&gt;${Appointment.Subject}&lt;/div&gt;
            &lt;div class="description"&gt;${Appointment.Description}&lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="field-group"&gt;
        &lt;div class="field-area"&gt;
            &lt;div class="field-name"&gt;Start&lt;/div&gt;
            &lt;div class="field-value"&gt;${Appointment.Start}&lt;/div&gt;
        &lt;/div&gt;
        &lt;div class="field-area"&gt;
            &lt;div class="field-name"&gt;End&lt;/div&gt;
            &lt;div class="field-value"&gt;${Appointment.End}&lt;/div&gt;
        &lt;/div&gt;
        &lt;div class="field-area"&gt;
            &lt;div class="field-name"&gt;Location&lt;/div&gt;
            &lt;div class="field-value"&gt;${Appointment.Location}&lt;/div&gt;
        &lt;/div&gt;
        &lt;div class="field-area"&gt;
            &lt;div class="field-name"&gt;Reminder&lt;/div&gt;
            &lt;div class="field-value"&gt;${Reminder}&lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;</value>
  </data>
