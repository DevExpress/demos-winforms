@namespace DevExpress.AI.Demos
@using DevExpress.AI.Demos.Models

@if (WeatherData != null)
{
    <div class="weather-widget">
        <!-- Current Weather Block -->
        <div class="current-weather-card">
            <div class="cw-header">
                <span class="cw-title">Current weather</span>
                <span class="cw-time">@DateTime.Now.ToString("h:mm tt")</span>
            </div>

            <div class="cw-main">
                <div class="cw-icon">
                    @GetWeatherEmoji(WeatherData.Icon)
                </div>
                <div class="cw-temp">
                    <span class="cw-temp-value">@Math.Round(WeatherData.Temperature)</span><span class="cw-temp-unit">°C</span>
                </div>
                <div class="cw-condition">
                    <span class="cw-desc">@(string.IsNullOrEmpty(WeatherData.Description) ? string.Empty : char.ToUpper(WeatherData.Description[0]) + WeatherData.Description.Substring(1))</span>
                    <span class="cw-feels">Feels like @Math.Round(WeatherData.FeelsLike)°</span>
                </div>
            </div>

            <div class="cw-details">
                <div class="cw-detail">
                    <span class="cw-detail-label">Wind</span>
                    <span class="cw-detail-value">@Math.Round(WeatherData.WindSpeed, 1) m/s</span>
                </div>
                <div class="cw-detail">
                    <span class="cw-detail-label">Humidity</span>
                    <span class="cw-detail-value">@WeatherData.Humidity%</span>
                </div>
                <div class="cw-detail">
                    <span class="cw-detail-label">Pressure</span>
                    <span class="cw-detail-value">@WeatherData.Pressure mb</span>
                </div>
                <div class="cw-detail">
                    <span class="cw-detail-label">Sunrise</span>
                    <span class="cw-detail-value">@WeatherData.Sunrise.ToLocalTime().ToString("h:mm tt")</span>
                </div>
                <div class="cw-detail">
                    <span class="cw-detail-label">Sunset</span>
                    <span class="cw-detail-value">@WeatherData.Sunset.ToLocalTime().ToString("h:mm tt")</span>
                </div>
            </div>
        </div>

        <!-- Weekly Forecast Block -->
        @if (WeatherData.FiveDayForecast?.Count > 0)
        {
            <div>
                <div class="forecast-row">
                    @{ var days = WeatherData.FiveDayForecast.GetRange(0, Math.Min(5, WeatherData.FiveDayForecast.Count)); }
                    @for (int i = 0; i < days.Count; i++)
                    {
                        var day = days[i];
                        var isToday = day.Date.Date == DateTime.Today;
                        <div class="fc-day-card @(isToday ? "fc-day-selected" : "")">
                            <div class="fc-day-header">
                                <span class="fc-day-num">@day.Date.Day</span>
                                <span class="fc-day-name">@GetDayLabel(day.Date)</span>
                            </div>
                            <div class="fc-day-body">
                                <div class="fc-day-icon">
                                    @GetWeatherEmoji(day.Icon)
                                </div>
                                <div class="fc-day-temps">
                                    <span class="fc-temp-high">@Math.Round(day.MaxTemp)°</span>
                                    <span class="fc-temp-low">@Math.Round(day.MinTemp)°</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<style>
    .weather-widget {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        max-width: 700px;
        animation: ww-slideUp 0.5s ease;
    }

    @@keyframes ww-slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ── Current Weather Card ── */
    .current-weather-card {
        background: #ffffffd9;
        border-radius: 20px;
        padding: 1.5rem 1.75rem;
    }

    .cw-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .cw-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .cw-time {
        font-size: 0.85rem;
        color: #555;
    }

    .cw-main {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
    }

    .cw-icon {
        font-size: 4rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .cw-temp {
        display: flex;
        align-items: flex-start;
        flex-shrink: 0;
    }

    .cw-temp-value {
        font-size: 3.5rem;
        font-weight: 400;
        color: #1a1a1a;
        line-height: 1;
    }

    .cw-temp-unit {
        font-size: 1.5rem;
        color: #1a1a1a;
        font-weight: 500;
        margin-top: 0.2rem;
    }

    .cw-condition {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .cw-desc {
        font-size: 1.1rem;
        font-weight: 500;
        color: #1a1a1a;
    }

    .cw-feels {
        font-size: 0.85rem;
        color: #555;
    }

    .cw-details {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        padding-top: 1rem;
    }

    .cw-detail {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .cw-detail-label {
        font-size: 0.75rem;
        color: #666;
    }

    .cw-detail-value {
        font-size: 0.9rem;
        font-weight: 600;
        color: #1a1a1a;
    }

    /* ── Forecast Card ── */
    .forecast-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
        gap: 0.5rem;
    }

    .fc-day-card {
        background: #ffffffd9;
        border-radius: 16px;
        padding: 0.75rem 0.6rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        transition: transform 0.2s ease;
    }

    .fc-day-card:hover {
        transform: translateY(-2px);
    }

    .fc-day-selected {
        background: #2c3e7a;
        color: #fff;
    }

    .fc-day-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        width: 100%;
        padding: 0 0.2rem;
    }

    .fc-day-num {
        font-size: 1.15rem;
        font-weight: 700;
        color: #888;
    }

    .fc-day-selected .fc-day-num {
        color: #fff;
    }

    .fc-day-name {
        font-size: 1rem;
        color: #666;
        font-weight: 400;
    }

    .fc-day-selected .fc-day-name {
        color: rgba(255, 255, 255, 0.75);
    }

    .fc-day-body {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }

    .fc-day-icon {
        font-size: 2.2rem;
        line-height: 1;
        margin: 0.25rem 0;
    }

    .fc-day-temps {
        display: flex;
        flex-direction: column;
        align-items: center;
        align-self: center;
        padding-right: 0.2rem;
    }

    .fc-temp-high {
        font-size: 1.15rem;
        font-weight: 500;
        color: #1a1a1a;
    }

    .fc-day-selected .fc-temp-high {
        color: #fff;
    }

    .fc-temp-low {
        font-size: 0.9rem;
        font-weight: 400;
        color: #888;
    }

    .fc-day-selected .fc-temp-low {
        color: rgba(255, 255, 255, 0.6);
    }
</style>

@code {
    [Parameter]
    public WeatherWidgetData WeatherData { get; set; }

    private string GetDayLabel(DateTime date)
    {
        if (date.Date == DateTime.Today)
            return "Today";
        if (date.Date == DateTime.Today.AddDays(-1))
            return "Yesterday";
        return date.ToString("ddd");
    }

    private string GetWeatherEmoji(string iconCode)
    {
        if (string.IsNullOrEmpty(iconCode))
            return "🌤️";

        return iconCode switch
        {
            "01d" => "☀️",
            "01n" => "🌙",
            "02d" => "🌤️",
            "02n" => "☁️",
            "03d" or "03n" => "☁️",
            "04d" or "04n" => "☁️",
            "09d" or "09n" => "🌧️",
            "10d" => "🌦️",
            "10n" => "🌧️",
            "11d" or "11n" => "⛈️",
            "13d" or "13n" => "❄️",
            "50d" or "50n" => "🌫️",
            _ => "🌤️"
        };
    }
}
