  <data name="tileView1.TileHtmlTemplate.Styles" xml:space="preserve">
    <value>.root {
	height: 84px;
	font-family: "Segoe UI";
	font-size: 14px;
	background-color: @Window;
	border-style: solid;
	border-width: 0px;
	border-left-width: 4px;
	border-left-color: @Window;
}
.content {
	margin-top:18%;
	margin-bottom:18%;
	margin-Left:16px;
	margin-right:20px;
	display:flex;
	background-color:@Window;
}
.initials {
	color: @White;
	font-weight: bold;
	background-color: @Primary;
	border-radius: 100px;
	width: 32px;
	height: 32px;
	display: flex;
	align-items: center;
	justify-content: center;
}
.photo {
	width:32px;
	height:32px;
	border-radius:100px;
	border: solid 1px @Primary;
	object-fit:contain;
	background-color:white;
}
.mail-content {
	flex-grow: 1;
	margin-left: 8px;
}
.plaintext {
	text-overflow:ellipsis;
	overflow:hidden;
	white-space:nowrap;
}
.date {
	align-self:center;
	text-align:right;
}
.from {
	text-overflow:ellipsis;
	overflow:hidden;
	white-space:nowrap;
	margin-top:-4px;
	font-weight:normal;
}
.bold-text {
	font-weight:bold;
}
.subject {
	text-overflow:ellipsis;
	overflow:hidden;
	white-space:nowrap;
}
.unread-stripe {
	border-left-color: @Primary;
}
.unread-color {
	color: @Primary;
}
.hidden {
	display:none;
}
.buttons {
	margin-right:-6px;
	display:flex;
	flex-wrap:nowrap;
	justify-content:flex-end;
}

.btn {
	width:18px;
	height:18px;
	min-width:18px;
	object-fit:contain;
	opacity:0;
}
.opaque { opacity:1; }
.root:hover .btn { opacity: 0.5; }
.root .btn:hover { opacity: 1; }
</value>
  </data>
  <data name="tileView1.TileHtmlTemplate.Template" xml:space="preserve">
    <value>&lt;div class="root" dx-class="{IsUnread:unread-stripe}"&gt;
	&lt;div class="content"&gt;
		&lt;div class="initials" dx-class="{HasPhoto:hidden}"&gt;${FromInitials}&lt;/div&gt;
		&lt;div dx-class="{HasPhoto:,hidden}"&gt;&lt;img class="photo" src="${Photo}"/&gt;&lt;/div&gt;
		&lt;div class="mail-content"&gt;
			&lt;div class="from" id="from" dx-class="{IsUnread:bold-text}"&gt;${From}&lt;/div&gt;
			&lt;div class="subject" dx-class="{IsUnread:bold-text unread-color}"&gt;${SubjectDisplayText}&lt;/div&gt;
			&lt;div class="plaintext"&gt;${PlainText}&lt;/div&gt;
		&lt;/div&gt;
		&lt;div&gt;
			&lt;div class="buttons"&gt;
				&lt;img class="btn" src="reply" onclick="OnReply"/&gt;
				&lt;img class="btn" src="delete" onclick="OnDelete"/&gt;
				&lt;img class="btn" dx-class="{Flagged:opaque}" src="flag" onclick="OnFlag"/&gt;
				&lt;img class="btn opaque" dx-class="{IsImportant:,hidden}" src="important"/&gt;
			&lt;/div&gt;
			&lt;div class="date" dx-class="{IsUnread:unread-color}"&gt;${Date}&lt;/div&gt;
		&lt;/div&gt;
	&lt;/div&gt;
&lt;/div&gt;</value>
  </data>
