  <data name="htmlTemplate1.Styles" xml:space="preserve">
    <value>.contact {
	height: 72px;
	display: flex;
	flex-direction: row;
	align-items: stretch;
	background-color: @Window;
	color: @WindowText;
}

.contact-avatar {
	padding: 4px;
	width: 64px;
	height: 64px;
}

.photo {
	background-color:White;
	margin: 8px;
	width: 48px;
	height: 48px;
	border-radius: 24px;
	border: 1px solid @WindowText/0.1;
	object-fit:contain;
}

.status {
	margin-top: -64px;
	margin-left: 48px;
	width: 8px;
	height: 8px;
	border-style: solid;
	border-width: 4px;
	border-color: @Window;
	background-color: @Warning;
	border-radius: 8px;
}

.contact-body {
	height: 70px;
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-grow: 1;
	padding-right: 12px;
}

.contact-info {
	flex-grow: 1;
}

.contact-info:hover .info {
	opacity: 0.5;
}

.contact-info .info:hover {
	opacity: 1.0;
}

.name-info {
	display: flex;
	align-items: center;
}

.name {
	font-size: 18px;
	line-height: 24px;
	overflow-x: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.info {
	margin-left: 4px;
	min-width: 16px;
	width: 16px;
	height: 16px;
	opacity: 0;
}

.phone {
	color: @DisabledText;
	font-size: 12px;
	line-height: 18px;
	overflow-x: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.selection {
	border-top: solid 1px @Window;
	border-bottom: solid 1px @WindowText/0.1;
}
:root:select .selection {
	border-top: solid 0px @Window;
	border-bottom: solid 2px @HighlightAlternate;
}</value>
  </data>
  <data name="htmlTemplate1.Template" xml:space="preserve">
    <value>&lt;div class="contact"&gt;
    &lt;div class="contact-avatar"&gt;
        &lt;img class="photo" src="${Photo}" /&gt;
        &lt;div class="status" id="status"&gt;&lt;/div&gt;
    &lt;/div&gt;
	&lt;div style="flex-grow:1;"&gt;
        &lt;div class="contact-body"&gt;
            &lt;div class="contact-info"&gt;
                &lt;div class="name-info"&gt;
                    &lt;div class="name"&gt;${FirstName} {LastName}&lt;/div&gt;
                    &lt;img class='info' src='Contact' id="info" /&gt;
                &lt;/div&gt;
                &lt;div class="phone"&gt;${HomePhone}&lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
        &lt;div class='selection'&gt;&lt;/div&gt;
	&lt;/div&gt;
&lt;/div&gt;</value>
  </data>
