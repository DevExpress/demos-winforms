  <data name="htmlContentPopup.HtmlTemplate.Styles" xml:space="preserve">
    <value>.tooltip {
    width: 328px;
    height: 328px;
    display: flex;
    flex-direction: row-reverse;
    margin: 8px 16px 24px 8px;
}

.beak-left {
    width: 8px;
    height: 20px;
    min-width: 8px;
    max-height: 20px;
    align-self: center;
}

.shadow-container {
    border-radius: 8px;
    box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.25);
}

.container {
    background-color: @Window;
    color: @WindowText;
    width: 312px;
    height: 320px;
    border-radius: 8px;
    padding: 4px;
    box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.photo {
    width: 128px;
    height: 128px;
    min-width: 128px;
    min-height: 128px;
    border-radius: 100px;
    border: 1px solid @WindowText/0.1;
    margin-top: 36px;
    margin-bottom: 16px;
    object-fit:cover;
}

.name {
    font-size: 18px;
    line-height: 24px;
}

.email {
    color: @DisabledText;
    font-size: 14px;
    line-height: 21px;
}

.separator {
    align-self: stretch;
    margin: 16px 30px;
    height: 1px;
    background-color: @WindowText/0.1;
}

.button-panel {
    margin-bottom: 16px;
}

.button {
    padding: 8px;
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    margin: 0 20px;
    opacity: 0.5;
}

    .button:hover {
        border-radius: 4px;
        background-color: @Highlight;
    }

    .button:disabled {
        opacity: 0.25;
    }
</value>
  </data>
  <data name="htmlContentPopup.HtmlTemplate.Template" xml:space="preserve">
    <value>&lt;div class="tooltip"&gt;
    &lt;div class="shadow-container"&gt;
        &lt;div class="container"&gt;
            &lt;img class='photo' src='${Photo}' /&gt;
            &lt;div class="name"&gt;${FirstName} {LastName}&lt;/div&gt;
            &lt;div class="email"&gt;${Email}&lt;/div&gt;
            &lt;div class="separator"&gt;&lt;/div&gt;
            &lt;div class="button-panel"&gt;
                &lt;img id="btnPhoneCall" src="PhoneCall" class="button"&gt;
                &lt;img id="btnVideoCall" src="VideoCall" class="button"&gt;
                &lt;img id="btnMessage" src="Message" class="button"&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;img class='beak-left' src='Beak.Left' /&gt;
&lt;/div&gt;</value>
  </data>
</root>