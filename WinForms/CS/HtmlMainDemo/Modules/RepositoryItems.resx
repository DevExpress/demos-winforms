  <data name="htmlContentControl.HtmlTemplate.Styles" xml:space="preserve">
    <value>.page {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 100%;
}
.form {
	font-family: 'Segoe UI';
	font-size: 14px;
	display: flex;
	flex-direction: column;
	width: 400px;
	border-radius: 8px;
	background-color: @ReadOnly;
	border: 1px solid rgba(0, 0, 0, 0.1);
	box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
}
.caption {
	display: flex;
	justify-content: space-between;
	align-items: center;
	height: 32px;
	font-size: 12px;
	font-weight: 400;
	padding: 8px 8px 8px 16px;
}
.content {
	display: flex;
	flex-direction: column;
	padding: 16px 48px 48px 48px;
}
.default-avatar-container {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 32px;
	background-color: @Window;
	border: 1px solid rgba(80, 80, 80, 0.25);
	border-radius: 4px;
}
.avatar-container {
	padding: 20px;
}
.default-avatar {
	width: 54px;
	height: 54px;
	background-color: @Window;
}
.avatar {
	width: 128px;
	height: 128px;
	background-color: @Window;
}
.choose-photo {
	margin-top: 8px;
}
.input-box {
	display: flex;
	padding: 12px 16px;
	background-color: @Window;
	border: 1px solid rgba(80, 80, 80, 0.25);
	border-radius: 4px;
	margin-top: 8px;
}
.input {
	flex-grow: 1;
	background-color: @Window;
}
.tab-bar {
	display: flex;
	justify-content: space-between;
	margin-bottom: 16px;
}
.button {
	display: flex;
	justify-content: center;
	align-items: center;
	padding: 11px 16px;
	border-radius: 4px;
	font-weight: bold;
	font-size: 10px;
}
.tab-button {
	width: 38%;
}
.check-container {
	display: flex;
	margin-top: 16px;
	font-size: 12px;
	align-items: center;
}
.check-box {
	margin-right: 5px;
	background-color: @ReadOnly;
}
.link:hover {
	text-decoration: underline;
}
.login-button {
	padding: 12px 24px;
	background-color: @Window;
	color: @WindowText;
	box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.1);
	border-radius: 6px;
	margin-top: 24px;
	font-size: 18px;
}
.login-button:hover {
	background-color: @HighlightAlternate;
	box-shadow: 0px 8px 16px @HighlightAlternate/0.5;
	color: White;
}
.login-button:active {
	box-shadow: initial;
	color: rgba(255, 255, 255, 0.35);
}
.normal {
	background-color: rgba(80, 80, 80, 0.05);
}
.normal:hover {
	background-color: @Highlight;
}
.highlight {
	background-color: @HighlightAlternate;
	color: white;
}</value>
  </data>
  <data name="htmlContentControl.HtmlTemplate.Template" xml:space="preserve">
    <value>&lt;div class='page theme'&gt;
	&lt;div class='form'&gt;
		&lt;div class='caption'&gt;
			Login Form
		&lt;/div&gt;
		&lt;div class='content'&gt;
			&lt;div class='tab-bar'&gt;
				&lt;div class='button tab-button highlight'&gt;
					LOGIN
				&lt;/div&gt;
				&lt;div class='button tab-button normal' id='signup'&gt;
					SIGN UP
				&lt;/div&gt;
			&lt;/div&gt;
			&lt;div class='input-box'&gt;
				&lt;input class='input' name='emailEdit' value='${Email}'/&gt;
			&lt;/div&gt;
			&lt;div class='input-box'&gt;
				&lt;input class='input' name='passEdit' value='${Password}'/&gt;
			&lt;/div&gt;
			&lt;div class='check-container'&gt;
				&lt;input class='check-box' name='checkEdit' value='${RememberMe}' /&gt;
				Remember me
			&lt;/div&gt;
			&lt;div class='button login-button'&gt;
				Login
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/div&gt;
&lt;/div&gt;</value>
